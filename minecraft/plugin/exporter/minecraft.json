{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plakar Minecraft Server Exporter Connector Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location"
  ],
  "properties": {
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "minecraft://<server directory> to restore into"
    },
    "allow_running": {
      "type": "boolean",
      "description": "Restore even if a server runs in the directory",
      "default": false
    },
    "rcon": {
      "type": "string",
      "description": "host:port of the RCON console, read from server.properties when omitted"
    },
    "timeout": {
      "type": "string",
      "description": "Time allowed for each RCON exchange, such as 30s",
      "default": "30s"
    },
    "skip_ownership": {
      "type": "boolean",
      "description": "Do not restore file ownership",
      "default": false
    },
    "skip_permissions": {
      "type": "boolean",
      "description": "Do not restore file permissions",
      "default": false
    },
    "skip_times": {
      "type": "boolean",
      "description": "Do not restore modification times",
      "default": false
    }
  }
}
